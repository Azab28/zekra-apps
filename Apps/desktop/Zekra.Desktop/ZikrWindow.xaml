<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zekra.Desktop.ZikrWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" FlowDirection="RightToLeft" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Padding="18,12,18,16" Spacing="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="LogoHost" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="ذِكرى · اذكر الله" VerticalAlignment="Center" Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button AllowFocusOnInteraction="False" Grid.Column="2" Click="OnClose" Padding="6" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="إغلاق" AutomationProperties.Name="إغلاق">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="Phrase" FontFamily="{StaticResource ZikrFont}" FontSize="34" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Foreground="{ThemeResource EmeraldBrush}" />

            <!-- Tap to count -->
            <Button AllowFocusOnInteraction="False" x:Name="Counter" HorizontalAlignment="Center" Width="96" Height="96" CornerRadius="48" Padding="0"
                    Style="{StaticResource AccentButtonStyle}" Click="OnTap" AutomationProperties.Name="سبّح">
                <TextBlock x:Name="Count" FontSize="34" FontWeight="SemiBold" Text="٠" />
            </Button>
            <TextBlock x:Name="TotalText" HorizontalAlignment="Center" Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <!-- Time left before it hides by itself (paused while the pointer is over it) -->
        <ProgressBar x:Name="Left" Grid.Row="1" Maximum="1" Value="1" Margin="18,0,18,12" />
    </Grid>
</Window>
