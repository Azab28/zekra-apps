<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zekra.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" FlowDirection="RightToLeft" Padding="18,16,18,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo, place -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="LogoHost" VerticalAlignment="Center" />
            <!-- In right-to-left layout "Right" is the far (left) side. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <FontIcon Glyph="&#xE81D;" FontSize="13" Foreground="{ThemeResource EmeraldBrush}" />
                <TextBlock x:Name="PlaceText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </StackPanel>
        </Grid>

        <!-- Dates -->
        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock x:Name="DateText" Style="{StaticResource BodyTextBlockStyle}" />
            <TextBlock x:Name="HijriText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource GoldBrush}" />
        </StackPanel>

        <!-- The next prayer -->
        <Border Grid.Row="2" Background="{ThemeResource NextCardBrush}" CornerRadius="8" Padding="16,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="الصلاة القادمة" Foreground="{ThemeResource NextCardForeground}" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="NextName" Foreground="{ThemeResource NextCardForeground}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="NextAt" Foreground="{ThemeResource NextCardForeground}" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <TextBlock x:Name="Countdown" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                           Foreground="{ThemeResource NextCardForeground}" FlowDirection="LeftToRight" />
            </Grid>
        </Border>

        <!-- Today's times -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <StackPanel x:Name="TimesList" />
        </Border>

        <!-- Sections -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button x:Name="AzkarButton" HorizontalAlignment="Stretch" Click="OnAzkar" AutomationProperties.Name="الأذكار">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE8F1;" />
                    <TextBlock Text="الأذكار" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnQibla" AutomationProperties.Name="القبلة">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE707;" />
                    <TextBlock Text="القبلة" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnSettings" AutomationProperties.Name="الإعدادات">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE713;" />
                    <TextBlock Text="الإعدادات" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
