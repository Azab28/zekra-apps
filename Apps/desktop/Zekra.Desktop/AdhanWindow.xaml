<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zekra.Desktop.AdhanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" FlowDirection="RightToLeft" Padding="18,14,18,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="LogoHost" VerticalAlignment="Center" />
            <TextBlock x:Name="Kicker" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
            <Button AllowFocusOnInteraction="False" Grid.Column="2" Click="OnClose" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="إغلاق" AutomationProperties.Name="إغلاق">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource EmeraldBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="Detail" Opacity="0.85" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="DuaCard" Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
            <StackPanel Spacing="4">
                <TextBlock Text="دعاء ما بعد الأذان" Foreground="{ThemeResource GoldBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="Dua" FontFamily="{StaticResource ZikrFont}" FontSize="21" LineHeight="34" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button AllowFocusOnInteraction="False" x:Name="StopButton" Style="{StaticResource AccentButtonStyle}" Click="OnStop" AutomationProperties.Name="إيقاف الأذان">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="إيقاف الأذان" />
                </StackPanel>
            </Button>
            <Button AllowFocusOnInteraction="False" Content="إغلاق" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
