<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Zekra.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GoldBrush" Color="#B07F25" />
                    <SolidColorBrush x:Key="EmeraldBrush" Color="#05684C" />
                    <SolidColorBrush x:Key="NextCardBrush" Color="#05684C" />
                    <SolidColorBrush x:Key="NextCardForeground" Color="#F7FBF9" />
                    <SolidColorBrush x:Key="NextRowBrush" Color="#1405684C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GoldBrush" Color="#DEB866" />
                    <SolidColorBrush x:Key="EmeraldBrush" Color="#54C398" />
                    <SolidColorBrush x:Key="NextCardBrush" Color="#0E4A3A" />
                    <SolidColorBrush x:Key="NextCardForeground" Color="#F2FAF6" />
                    <SolidColorBrush x:Key="NextRowBrush" Color="#2254C398" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ذِكرى's emerald (the site's primary colour) as the accent, whatever the system accent is. -->
            <Color x:Key="SystemAccentColor">#05684C</Color>
            <Color x:Key="SystemAccentColorDark1">#05684C</Color>
            <Color x:Key="SystemAccentColorDark2">#045540</Color>
            <Color x:Key="SystemAccentColorDark3">#033F30</Color>
            <Color x:Key="SystemAccentColorLight1">#2E9677</Color>
            <Color x:Key="SystemAccentColorLight2">#54C398</Color>
            <Color x:Key="SystemAccentColorLight3">#8ED9BC</Color>

            <!-- Azkar and duas: a naskh face with clear harakat that ships with Windows. -->
            <FontFamily x:Key="ZikrFont">Sakkal Majalla</FontFamily>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,18,2,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
