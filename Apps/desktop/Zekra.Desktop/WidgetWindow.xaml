<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zekra.Desktop.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" FlowDirection="RightToLeft" Padding="10,0,10,0" ColumnSpacing="8" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE823;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource EmeraldBrush}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
            <TextBlock x:Name="NameText" FontSize="12" FontWeight="SemiBold" />
            <!-- "Left" is the start (right) side in right-to-left layout -->
            <TextBlock x:Name="CountdownText" FontSize="12" Opacity="0.85" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Window>
