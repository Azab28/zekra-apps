<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zekra.Desktop.AzkarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="LogoHost" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="الأذكار — حصن المسلم" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Padding="12,0,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="Search" PlaceholderText="ابحث في الأبواب" QueryIcon="Find" TextChanged="OnSearch" />
                <ListView x:Name="Chapters" Grid.Row="1" DisplayMemberPath="Title" SelectionMode="Single" SelectionChanged="OnChapter" />
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ScrollViewer x:Name="ItemsScroll">
                    <StackPanel Padding="24,16,24,24" Spacing="12" MaxWidth="820">
                        <Grid>
                            <TextBlock x:Name="ChapterTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,0" />
                            <Button x:Name="ResetButton" HorizontalAlignment="Right" Click="OnReset" ToolTipService.ToolTip="ابدأ العدّ من جديد" AutomationProperties.Name="إعادة">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="إعادة" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="Items" Spacing="12" />
                        <TextBlock Text="المصدر: حصن المسلم (hisnmuslim.com)" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
